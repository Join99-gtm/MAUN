<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net452</TargetFramework>
    <AssemblyName>GooseDeluxe</AssemblyName>
    <RootNamespace>GooseDeluxe</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.8.4</Version>
    <Product>GooseDeluxe</Product>
    <Description>Graphics and animation overhaul mod for Desktop Goose 0.31</Description>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <None Include="GooseDeluxe.ini" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Фразы.txt" LogicalName="GooseDeluxe.Phrases.txt" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Speech" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="GooseModdingAPI">
      <HintPath>../lib/GooseModdingAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
