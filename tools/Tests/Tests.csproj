<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless tests: compiles the mod's WinForms-free sources for .NET 8 with HEADLESS and exercises them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <DefineConstants>HEADLESS</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1701;CS1702;NU1701;SYSLIB0014;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../GooseDeluxe/M.cs" />
    <Compile Include="../../GooseDeluxe/Deluxe.cs" />
    <Compile Include="../../GooseDeluxe/DeluxeConfig.cs" />
    <Compile Include="../../GooseDeluxe/RussianPack.cs" />
    <Compile Include="../../GooseDeluxe/Particles.cs" />
    <Compile Include="../../GooseDeluxe/GooseAnimator.cs" />
    <Compile Include="../../GooseDeluxe/GooseRenderer.cs" />
    <Compile Include="../../GooseDeluxe/Guests.cs" />
    <Compile Include="../../GooseDeluxe/Fixes/FixedTimestep.cs" />
    <Compile Include="../../GooseDeluxe/Fixes/DeckFixer.cs" />
    <Compile Include="../../GooseDeluxe/Fixes/GooseSettings.cs" />
    <Compile Include="../../GooseDeluxe/Fixes/HotkeyPoller.cs" />
    <Compile Include="../../GooseDeluxe/GooseHit.cs" />
    <Compile Include="../../GooseDeluxe/ModInfo.cs" />
    <Compile Include="../../GooseDeluxe/UI/IGooseControls.cs" />
    <Compile Include="../../GooseDeluxe/Net/*.cs" />
    <Compile Include="../../GooseDeluxe/Tasks/*.cs" />
    <Compile Include="../../GooseDeluxe/Seasons/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <Reference Include="GooseModdingAPI">
      <HintPath>../../lib/GooseModdingAPI.dll</HintPath>
    </Reference>
    <RuntimeHostConfigurationOption Include="System.Drawing.EnableUnixSupport" Value="true" />
  </ItemGroup>
</Project>
